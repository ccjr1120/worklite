{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkLite",
  "version": "0.1.0",
  "identifier": "com.worklite.desktop",
  "build": {
    "devUrl": "http://localhost:3390",
    "frontendDist": "https://worklite.example.com"
  },
  "app": {
    "windows": [
      {
        "title": "WorkLite",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
