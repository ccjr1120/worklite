# SQLite
SQLITE_PATH=.data/worklite.db

# API
API_PORT=4546
CODEX_PROXY_HOST=127.0.0.1
CODEX_PROXY_PORT=4548
# Required by apps/codex-proxy when the Codex sidecar is enabled.
CODEX_PROXY_API_KEY=
CODEX_ACCESS_TOKEN=
CODEX_ACCOUNT_ID=
CODEX_UPSTREAM_URL=https://chatgpt.com/backend-api/codex
API_HOST=127.0.0.1

# S3-compatible object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=worklite
S3_SECRET_KEY=worklite-secret
S3_BUCKET=worklite
S3_FORCE_PATH_STYLE=true
