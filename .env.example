# PostgreSQL
DATABASE_URL=postgres://worklite:worklite@localhost:5432/worklite

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000

# S3-compatible object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=worklite
S3_SECRET_KEY=worklite-secret
S3_BUCKET=worklite
S3_FORCE_PATH_STYLE=true
