# SQLite
SQLITE_PATH=../../.data/deployment/worklite.db
PORTKEY_GATEWAY_DB_PATH=../../.data/deployment/worklite-gateway.db
# Optional externally reachable WorkLite base URL for authorization links (e.g. https://worklite.example.com).
# Without it, a token-only QR page listener uses an ephemeral LAN port; the phone must be on the same LAN.
# The main management API remains bound to loopback. Links expire after 15 minutes.
WORKLITE_PUBLIC_URL=
# Chat image attachments live beside SQLITE_PATH in chat-attachments/ and expire like Gateway request logs.
CHAT_ATTACHMENT_RETENTION_HOURS=12
# Retention runs on separate SQLite worker connections, every 15 minutes.
# Backlogs retry every 5 seconds. Each delete batch and vacuum chunk is bounded.
# Set any *_RETENTION_* window below to 0 to disable that expiry policy.
SQLITE_MAINTENANCE_INTERVAL_MINUTES=15
SQLITE_MAINTENANCE_CATCH_UP_SECONDS=5
SQLITE_MAINTENANCE_BATCH_ROWS=500
SQLITE_WAL_SIZE_LIMIT_MEGABYTES=64
# Total page budget per pass (individual vacuum writes move at most 16 pages).
SQLITE_INCREMENTAL_VACUUM_PAGES=1024
# Terminal command records and their output expire after 30 days; saved tool results remain.
COMMAND_HISTORY_RETENTION_DAYS=30
# Until then, stdout/stderr older than 3 days retain a shared UTF-8 tail of 16 KiB.
COMMAND_STREAM_RETENTION_DAYS=3
COMMAND_STREAM_TAIL_KILOBYTES=16
# Replay events and settled project-task activities expire by event age, even in an
# active conversation. Latest snapshots, reconnect watermarks, round/steer bookkeeping,
# conversation messages, run results, artifacts and durable runtime usage remain.
RUN_EVENT_RETENTION_DAYS=7
# Copies of Skill code for successful, result-appended calls in completed executions.
# Active/failed executions retain their captured code for recovery and retry.
TOOL_PACKAGE_RETENTION_DAYS=7
API_REQUEST_LOG_RETENTION_DAYS=1
GATEWAY_REQUEST_LOG_RETENTION_HOURS=12
GATEWAY_STATS_RETENTION_DAYS=90
# Interval between model-only [活跃工作进展提醒] progress notes for conversations with active work.
CHAT_PROGRESS_NOTE_INTERVAL_SECONDS=300
# Chat's protected run_host_command executes arbitrary local shell commands through /bin/zsh -lc.
# Optional absolute existing cwd when a call omits cwd; defaults to the user home.
WORKLITE_CHAT_HOST_COMMAND_DEFAULT_CWD=
# Default per-call timeout and its configurable hard ceiling, in milliseconds.
WORKLITE_CHAT_HOST_COMMAND_TIMEOUT_MS=120000
WORKLITE_CHAT_HOST_COMMAND_MAX_TIMEOUT_MS=900000
# Bounds for result text and for each captured stdout/stderr tail, in characters.
WORKLITE_CHAT_HOST_COMMAND_OUTPUT_CHARS=20000
WORKLITE_CHAT_HOST_COMMAND_STREAM_CHARS=40000

# Managed deployment state retention under .data/<profile>/runtime.
# Release directories carry their own node_modules, so each one costs roughly a gigabyte.
# The running deployment and any release a pending upgrade needs are always kept.
WORKLITE_RELEASE_RETENTION=3
WORKLITE_UPGRADE_RECORD_RETENTION_DAYS=30

# API
API_PORT=23391
PORTKEY_GATEWAY_PORT=23392
# Required by stored MCP and Model Provider secrets; keep this deployment secret stable and out of source control.
SECRET_ENCRYPTION_KEY=
# Optional bootstrap credential; OAuth login can persist the Codex credential in Gateway SQLite.
CODEX_ACCESS_TOKEN=
CODEX_ACCOUNT_ID=
CODEX_UPSTREAM_URL=https://chatgpt.com/backend-api/codex
CODEX_CLIENT_VERSION=26.707.31428
CODEX_USER_AGENT=Codex Desktop/26.707.31428 (win32; x64)
CODEX_ORIGINATOR=codex_cli_rs
CODEX_RESIDENCY=us
# OAuth login uses the Codex CLI-registered localhost callback. Remote operators
# should forward this port securely instead of changing the redirect URI.
CODEX_OAUTH_CALLBACK_ENABLED=true
# Codex App Server uses the local codex command and CODEX_HOME (default ~/.codex).
API_HOST=127.0.0.1

# S3-compatible object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=worklite
S3_SECRET_KEY=worklite-secret
S3_BUCKET=worklite
S3_FORCE_PATH_STYLE=true

# Agent file catalog; defaults to ~/.worklite/agents, independent of deployment releases.
# WORKLITE_AGENTS_DIR=/absolute/path/to/.worklite/agents
