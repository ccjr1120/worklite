{
  "extends": "@worklite/config/typescript/node.json",
  "compilerOptions": {
    "noEmit": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // Type checking reaches into the workspace packages this app keeps external,
    // whose relative imports carry a ".ts" extension because Node resolves them.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
