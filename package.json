{
  "name": "worklite",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./scripts/kill-dev-ports.mjs && pnpm --filter @worklite/web dev",
    "dev:web": "pnpm --filter @worklite/web dev",
    "deploy:local": "node ./scripts/bump-deployment-version.mjs && node ./scripts/upgrade-runner.mjs deploy deployment",
    "diagnose:responses": "node ./scripts/check-responses-stream.mjs",
    "diagnose:codex": "node ./scripts/test-codex-proxy.mjs",
    "typecheck": "turbo typecheck",
    "lint": "eslint . --max-warnings=0",
    "knip": "knip",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "knip": "^5.66.3",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
