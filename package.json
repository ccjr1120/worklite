{
  "name": "worklite",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./scripts/kill-dev-ports.mjs && turbo dev",
    "dev:web": "pnpm --filter @worklite/web dev",
    "dev:api": "pnpm --filter @worklite/api dev",
    "dev:worker": "pnpm --filter @worklite/worker dev",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^26.1.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
